#!/usr/bin/env bash
# /usr/local/sbin/soar-nginx-deny — chan IP o Nginx (lop 7) co TTL (DATN, Goi A)
#
# Shuffle goi qua SSH (user soar, sudo chi cho script nay):
#   sudo /usr/local/sbin/soar-nginx-deny add <ip> <ttl_giay>   (ttl 0 = khong tu go)
#   sudo /usr/local/sbin/soar-nginx-deny del <ip>
#   sudo /usr/local/sbin/soar-nginx-deny test <ip>             in PRESENT hoac ABSENT
#   sudo /usr/local/sbin/soar-nginx-deny list
#   sudo /usr/local/sbin/soar-nginx-deny expire                (timer soar-nginx-expire chay moi phut)
#
# Danh sach deny nam trong /etc/nginx/conf.d/soar-deny.conf (ngu canh http{}, ap dung cho moi server).
# Moi lan doi deu chay "nginx -t" truoc khi reload; loi thi tra lai ban cu.
set -euo pipefail

STATE=/var/lib/soar/nginx-deny.state
CONF=/etc/nginx/conf.d/soar-deny.conf
mkdir -p /var/lib/soar
touch "$STATE"

log() { logger -t datn-soar "nginx-deny: $*"; }
die() { echo "ERROR $*"; log "ERROR $*"; exit 1; }

valid_ip() {
  [[ $1 =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o
  for o in "${BASH_REMATCH[@]:1}"; do (( 10#$o <= 255 )) || return 1; done
}
# Khong bao gio chan: VPN/EC2, loopback, gateway LAN, chinh may web, host/NAT VMware, WAN pfSense
protected_ip() {
  [[ $1 =~ ^(10\.99\.0\.|127\.) ]] && return 0
  [[ $1 =~ ^192\.168\.100\.(1|103)$ ]] && return 0
  [[ $1 =~ ^192\.168\.173\.(1|2|10)$ ]] && return 0
  return 1
}

render() {
  local tmp
  tmp=$(mktemp)
  {
    echo "# Sinh tu dong boi /usr/local/sbin/soar-nginx-deny luc $(date -Is). Khong sua tay."
    awk 'NF == 2 { print "deny " $1 ";" }' "$STATE"
  } > "$tmp"
  [ -f "$CONF" ] && cp -f "$CONF" "$CONF.bak"
  install -m 644 "$tmp" "$CONF"
  rm -f "$tmp"
  if ! nginx -t -q 2>/dev/null; then
    [ -f "$CONF.bak" ] && cp -f "$CONF.bak" "$CONF"
    die "nginx -t that bai, da tra lai ban cu"
  fi
  systemctl reload nginx
}

cmd_add() {
  local ip=${1:-} ttl=${2:-0} exp=0
  valid_ip "$ip" || die "IP khong hop le: $ip"
  protected_ip "$ip" && die "IP ha tang, tu choi: $ip"
  [[ $ttl =~ ^[0-9]{1,7}$ ]] || die "TTL khong hop le: $ttl"
  (( ttl > 0 )) && exp=$(( $(date +%s) + ttl ))
  grep -v "^$ip " "$STATE" > "$STATE.tmp" || true
  echo "$ip $exp" >> "$STATE.tmp"
  mv "$STATE.tmp" "$STATE"
  render
  echo "OK add $ip ttl=$ttl"
  log "add $ip ttl=$ttl"
}

cmd_del() {
  local ip=${1:-}
  valid_ip "$ip" || die "IP khong hop le: $ip"
  grep -v "^$ip " "$STATE" > "$STATE.tmp" || true
  mv "$STATE.tmp" "$STATE"
  render
  echo "OK del $ip"
  log "del $ip"
}

cmd_test() {
  local ip=${1:-}
  valid_ip "$ip" || die "IP khong hop le: $ip"
  if grep -q "^deny $ip;" "$CONF" 2>/dev/null; then echo "PRESENT nginx $ip"; else echo "ABSENT nginx $ip"; fi
}

cmd_expire() {
  local now changed=0 ip exp
  now=$(date +%s)
  : > "$STATE.tmp"
  while read -r ip exp; do
    [[ -n ${ip:-} ]] || continue
    if (( exp != 0 && exp <= now )); then
      log "expire $ip"
      changed=1
    else
      echo "$ip $exp" >> "$STATE.tmp"
    fi
  done < "$STATE"
  mv "$STATE.tmp" "$STATE"
  if (( changed )); then render; fi
}

case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  del)    shift; cmd_del "$@" ;;
  test)   shift; cmd_test "$@" ;;
  list)   cat "$CONF"; echo "--- $STATE (ip han_epoch; 0 = khong TTL)"; cat "$STATE" ;;
  expire) cmd_expire ;;
  *) echo "Dung: $0 add <ip> <ttl> | del <ip> | test <ip> | list | expire"; exit 2 ;;
esac
