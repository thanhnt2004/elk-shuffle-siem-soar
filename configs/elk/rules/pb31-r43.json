{
  "rule_id": "datn-pb31-r43",
  "name": "PB31 R43 - Nen roi tuon du lieu (Ubuntu)",
  "description": "Theo host.name: SYSCALL execve tar/zip/gzip roi SYSCALL execve nc/scp/socat/curl... trong 10 phut. process.name lay tu ban ghi SYSCALL (EXECVE bi mang hoa hex). T1560.001 + T1048.003.",
