  "language": "eql",
  "query": "sequence by host.name with maxspan=10m [process where event.action == \"syscall\" and process.name in (\"tar\",\"zip\",\"gzip\",\"7z\",\"7za\",\"bzip2\",\"xz\",\"zstd\")] [process where event.action == \"syscall\" and process.name in (\"nc\",\"ncat\",\"scp\",\"sftp\",\"socat\",\"curl\",\"wget\")]",
