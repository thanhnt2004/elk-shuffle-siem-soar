## /etc/audit/rules.d/datn.rules — key dùng cho rule R14 (cron), R15 (identity)
## Nạp: sudo augenrules --load ; kiểm tra: sudo auditctl -l

## R14 — T1053.003: ghi vào cấu hình cron
-w /etc/crontab -p wa -k cron
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /var/spool/cron/ -p wa -k cron
-w /usr/bin/crontab -p x -k cron

## R15 — T1136.001: tạo/sửa tài khoản
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /usr/sbin/useradd -p x -k identity
-w /usr/sbin/adduser -p x -k identity
-w /usr/sbin/usermod -p x -k identity

## Khóa SSH và cấu hình sshd (bằng chứng persistence)
-w /root/.ssh/ -p wa -k sshkeys
-w /etc/ssh/sshd_config -p wa -k sshkeys
-w /etc/ssh/sshd_config.d/ -p wa -k sshkeys

## Lệnh do người dùng thật chạy (auid >= 1000), bỏ qua tiến trình hệ thống
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=unset -k exec
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=unset -k exec
